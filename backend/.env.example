# Скопируйте в `.env` и подставьте локальные значения.
# Реальный `.env` игнорируется Git. Секреты в репозиторий не коммитятся.

NODE_ENV=development

# HTTP-сервер
PORT=3000
# Глобальный префикс из контракта (server: http://localhost:3000/api/v1)
API_PREFIX=api/v1

# PostgreSQL. Значение ниже — пример для локальной разработки, не секрет.
# Схема данных появится на этапе 5; на этапе каркаса соединение ленивое.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_call?schema=public

# Сгенерируйте локально: openssl rand -hex 32. Не используйте пример в production.
IDEMPOTENCY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Allowlist origin через запятую. Credentials отключены; `*` оставляйте только для отладки.
# 5173 — Vite dev, 4173 — preview, nullorone.github.io — будущий GitHub Pages frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://nullorone.github.io

# error | warn | log | debug | verbose
LOG_LEVEL=log

# RabbitMQ и transactional outbox. Установите false для режимов без messaging lifecycle.
MESSAGING_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=booking.events.v1
RABBITMQ_QUEUE=booking.notifications.v1
RABBITMQ_RETRY_EXCHANGE=booking.retry.v1
RABBITMQ_RETRY_QUEUE=booking.notifications.retry.v1
RABBITMQ_DLQ_EXCHANGE=booking.dlx.v1
RABBITMQ_DLQ=booking.notifications.dlq.v1
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_LIMIT=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_RECONNECT_MIN_MS=500
RABBITMQ_RECONNECT_MAX_MS=30000
RABBITMQ_CONFIRM_TIMEOUT_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_CLAIM_LEASE_MS=30000
