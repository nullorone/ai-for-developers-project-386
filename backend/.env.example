# Скопируйте в `.env` и подставьте локальные значения.
# Реальный `.env` игнорируется Git. Секреты в репозиторий не коммитятся.

NODE_ENV=development

# HTTP-сервер
PORT=3000
# Глобальный префикс из контракта (server: http://localhost:3000/api/v1)
API_PREFIX=api/v1

# PostgreSQL. Значение ниже — пример для локальной разработки, не секрет.
# Схема данных появится на этапе 5; на этапе каркаса соединение ленивое.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_call?schema=public

# Сгенерируйте локально: openssl rand -hex 32. Не используйте пример в production.
IDEMPOTENCY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Разрешенные origin через запятую (или `*` только для локальной отладки).
# 5173 — vite dev, 4173 — vite preview.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# error | warn | log | debug | verbose
LOG_LEVEL=log
