{
  "name": "booking-call-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend приложения «Запись на звонок» (NestJS). Независимый проект; контракт — корневой openapi.yaml.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "npm run prisma:generate",
    "test": "jest --runInBand",
    "test:integration": "RUN_DATABASE_TESTS=true jest --runInBand --testPathPattern=integration.e2e-spec.ts",
    "test:integration:container": "node test/run-postgres-suite.mjs integration",
    "test:concurrency": "RUN_DATABASE_TESTS=true jest --runInBand --testPathPattern=booking-lifecycle.integration.e2e-spec.ts --testNamePattern=concurrent|shared target|races",
    "test:concurrency:container": "node test/run-postgres-suite.mjs concurrency",
    "test:frontend-integration": "RUN_DATABASE_TESTS=true jest --runInBand --testPathPattern=frontend-backend.integration.e2e-spec.ts",
    "test:messaging": "RUN_MESSAGING_TESTS=true jest --runInBand --testPathPattern=messaging.integration.e2e-spec.ts",
    "test:full": "node test/run-postgres-suite.mjs full && npm run test:messaging",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.18.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.12",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.18.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
