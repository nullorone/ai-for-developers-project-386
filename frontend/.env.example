# Скопируйте в `.env.local` (или `.env`) и при необходимости измените.
# Реальные .env-файлы игнорируются Git и не должны попадать в репозиторий.
# Секретов у frontend нет: любая переменная с префиксом VITE_ попадает в бандл.

# Базовый адрес API.
# По умолчанию development подключается к реальному локальному backend:
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Изолированный mock mode (Prism обслуживает пути без /api/v1):
# VITE_API_BASE_URL=http://127.0.0.1:4010

# Базовый путь сборки. Для GitHub Pages из подкаталога репозитория:
# VITE_BASE_PATH=/ai-for-developers-project-386/
VITE_BASE_PATH=/
