# Local Docker Compose values only. Copy to `.env`; never reuse these credentials in production.
POSTGRES_DB=booking_call
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking-local-only
RABBITMQ_DEFAULT_USER=booking
RABBITMQ_DEFAULT_PASS=rabbit-local-only
# Generate a replacement with: openssl rand -hex 32
IDEMPOTENCY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional trusted npm proxy for corporate environments (never put auth tokens here):
# NPM_REGISTRY=https://registry.example.org/npm/
# NPM_CA_FILE=/absolute/path/to/corporate-ca.pem
# NPM_CONFIG_FILE=/absolute/path/to/private/.npmrc
